# Chaîne de connexion Neon (pooled), requise pour le mot de passe oublié
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clé API Resend, optionnelle : sans elle, le code s'affiche dans la console serveur
RESEND_API_KEY=

# Expéditeur des e-mails, format "Nom <adresse>"
RESEND_FROM=Espace entreprise <no-reply@votredomaine.resend.app>

# URL publique de l'app, utilisée dans le lien du mail
APP_URL=http://localhost:3000

# Secret de hachage des codes et des tickets (HMAC), requis : openssl rand -base64 32
RESET_CODE_SECRET=
